<script id="ip-save-now">
(function(){
  function norm(line){
    line=String(line||"").replace(/\s+/g,"");
    if(!line) return "";
    if(line.indexOf("://")>=0) return line;
    var a=line.split(":");
    if(a.length>=4) return "socks5://"+a.slice(2,a.length-1).join(":")+":"+a[a.length-1]+"@"+a[0]+":"+a[1];
    return line;
  }
  document.addEventListener("click", function(e){
    if(!e.target || e.target.id!=="btn-save-ip") return;
    e.preventDefault();
    e.stopPropagation();
    var ta=document.getElementById("ip-pool-text");
    var lines=((ta&&ta.value)||"").split(/\n+/).map(norm).filter(Boolean);
    if(!lines.length){ alert("请先填写要新增的 IP"); return; }
    fetch("/api/ip-pool-add",{
      method:"POST",
      credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({lines:lines})
    }).then(function(r){ return r.json(); }).then(function(d){
      if(ta) ta.value="";
      alert(d.status==="ok" ? ("已保存，当前 "+d.count+" 条，请刷新") : ("接口失败: "+(d.message||"未知")));
      location.reload();
    }).catch(function(err){
      alert("请求失败: "+err.message);
    });
  }, true);
})();
</script>


<script id="ip-save-force">
(function(){
  function norm(line){
    line=String(line||"").replace(/\s+/g,"");
    if(!line) return "";
    if(line.indexOf("://")>=0) return line;
    var a=line.split(":");
    if(a.length>=4){
      var host=a[0], port=a[1], pass=a[a.length-1], user=a.slice(2,a.length-1).join(":");
      return "socks5://"+user+":"+pass+"@"+host+":"+port;
    }
    return line;
  }
  function bind(){
    var btn=document.getElementById("btn-save-ip");
    if(!btn || btn.dataset.force==="1") return;
    btn.dataset.force="1";
    btn.onclick=async function(e){
      e.preventDefault(); e.stopImmediatePropagation();
      var ta=document.getElementById("ip-pool-text");
      var lines=((ta&&ta.value)||"").split(/\n/).map(norm).filter(Boolean);
      if(!lines.length){ alert("请先填写要新增的 IP"); return false; }
      try{
        var r=await fetch("/api/ip-pool-add",{
          method:"POST",
          credentials:"same-origin",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({lines:lines})
        });
        var txt=await r.text();
        var d={}; try{d=JSON.parse(txt);}catch(err){}
        alert("HTTP "+r.status+"\n"+txt.slice(0,180));
        if(d.status==="ok") location.reload();
      }catch(err){ alert("请求失败 "+err.message); }
      return false;
    };
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", bind);
  else bind();
  setInterval(bind, 1000);
})();
</script>


<script id="ip-del-js">
(function(){
  function addDel(){
    document.querySelectorAll("#ip-saved-box > div").forEach(function(card){
      if(card.querySelector("[data-del-ip]")) return;
      var px=(card.querySelector("div")||{}).textContent||"";
      px=px.trim();
      if(px.indexOf("socks")<0 && px.indexOf("://")<0) return;
      var b=document.createElement("button");
      b.type="button";
      b.className="btn btn-sm btn-danger";
      b.style.marginLeft="8px";
      b.textContent="删除";
      b.setAttribute("data-del-ip", px);
      b.onclick=async function(){
        if(!confirm("删除这条 IP？")) return;
        var r=await fetch("/api/ip-pool/delete",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({proxy:px})});
        var d=await r.json();
        if(d.status==="ok"){ card.remove(); location.reload(); }
        else alert(d.message||"删除失败");
      };
      var bind=card.querySelector("[data-bind]");
      if(bind&&bind.parentNode) bind.parentNode.insertBefore(b, bind.nextSibling);
      else card.appendChild(b);
    });
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", addDel);
  else addDel();
  setInterval(addDel, 800);
})();
</script>


<script id="ip-save-inline">
window.__saveIpPool = async function(){
  var ta=document.getElementById("ip-pool-text");
  var raw=(ta&&ta.value)||"";
  function norm(line){
    line=String(line||"").replace(/\s+/g,"");
    if(!line) return "";
    if(line.indexOf("://")>=0) return line;
    var a=line.split(":");
    if(a.length>=4){
      return "socks5://"+a.slice(2,a.length-1).join(":")+":"+a[a.length-1]+"@"+a[0]+":"+a[1];
    }
    return line;
  }
  var lines=raw.split(/\n/).map(norm).filter(Boolean);
  if(!lines.length){ alert("请先填写要新增的 IP，每行一条"); return; }
  try{
    var r=await fetch("/api/ip-pool-add",{
      method:"POST",
      credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({lines:lines})
    });
    var txt=await r.text();
    alert("HTTP "+r.status+"\n"+txt.slice(0,200));
    if(r.ok) location.reload();
  }catch(e){ alert("失败: "+e.message); }
};
</script>







<script src="/static/ipfix.js?v=1"></script>
</body>
</html>
