      return '<label style="display:block;padding:4px 0;font-size:13px;"><input type="checkbox" value="'+id+'" '+on+'> '+(a.name||"")+" "+(a.phone||id)+"</label>";
    }).join("");
    return '<div style="border:1px solid #e5e7eb;border-radius:8px;padding:10px;margin:8px 0;"><div style="word-break:break-all;font-size:13px;">'+proxy+'</div><div style="color:#6b7280;font-size:12px;margin:6px 0;">勾选要绑定的水军号</div><div class="ip-acc-sel" data-i="'+i+'" style="max-height:180px;overflow:auto;border:1px solid #e5e7eb;border-radius:6px;padding:8px;">'+checks+'</div><button type="button" class="btn btn-sm btn-primary" onclick="bindSavedIp('+i+')" style="margin-top:8px;">绑定选中的水军号</button></div>';
  }).join("");
};
window.bindSavedIp=async function(i){
  var it=(window.__ipItems||[])[i];
  var proxy=typeof it==="string"?it:(it&&(it.proxy||it.ip));
  var wrap=document.querySelector('.ip-acc-sel[data-i="'+i+'"]');
  var ids=wrap?[].slice.call(wrap.querySelectorAll("input[type=checkbox]:checked")).map(function(x){return x.value;}):[];
  var r=await fetch("/api/ip-pool/bind",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({proxy:proxy,account_ids:ids})});
  var d=await r.json();
  if(d.items) await drawIpSaved(d.items);
  alert((d.status==="ok"||d.status==="success")?("已绑定 "+ids.length+" 个号"):("绑定失败 "+(d.message||"")));
};
(async function(){
  var items=[];
  var urls=["/api/ip-pool","/api/ip-pool-data"];
  for(var i=0;i<urls.length;i++){
    try{
      var r=await fetch(urls[i],{credentials:"same-origin"});
      var d=await r.json();
      var x=d.items||d.data||[];
      if(x&&x.length){items=x;break;}
    }catch(e){}
  }
  await window.drawIpSavedDisabled(items);
})();
</script>


