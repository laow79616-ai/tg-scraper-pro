<script>
window.saveIpPoolPage = async function(){
  const ta = document.getElementById("ip-pool-text");
  const raw = (ta && ta.value) ? ta.value : "";
  const lines = raw.split(/\n+/).map(s=>s.trim()).filter(Boolean);
  function norm(line){
    line=line.replace(/\s+/g,"");
    if(!line) return "";
    if(line.startsWith("socks5://")||line.startsWith("http://")||line.startsWith("https://")) return line;
    const p=line.split(":");
    if(p.length>=4){
      const host=p[0], port=p[1], user=p.slice(2,-1).join(":"), pass=p[p.length-1];
      return "socks5://"+user+":"+pass+"@"+host+":"+port;
    }
    return line;
  }
  const added = lines.map(norm).filter(Boolean);
  if(!added.length){ alert("请先在输入框填写要新增的 IP"); return; }
  let items=[];
  try{
    const r=await fetch("/api/ip-pool-readonly",{credentials:"same-origin"});
    const d=await r.json();
    items=d.items||[];
  }catch(e){}
  const have=new Set(items.map(it=> (typeof it==="string"?it:(it.proxy||it.ip||""))));
  added.forEach(px=>{
    if(!have.has(px)){ items.push({proxy:px, account_ids:[]}); have.add(px); }
  });
  const text=items.map(it=> (typeof it==="string"?it:(it.proxy||""))).join("\n");
  let ok=false, last={};
  for (const u of ["/api/ip-pool","/api/ip-pool-data"]){
    try{
      const r=await fetch(u,{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({text, items})});
      last=await r.json();
      if(last && (last.status==="ok"||last.items)){ ok=true; if(last.items) items=last.items; break; }
    }catch(e){}
  }
  if(ta) ta.value="";
  if(typeof renderIpPoolLocked==="function") await renderIpPoolLocked();
  alert(ok ? ("已保存，当前 "+items.length+" 条") : ("前端已合并 "+items.length+" 条，后端接口可能未写入"));
};
document.getElementById("btn-save-ip") && document.getElementById("btn-save-ip").addEventListener("click", function(e){
  e.preventDefault();
  saveIpPoolPage();
});
</script>


<script>
function normIpLine(line){
  line=(line||"").replace(/\s+/g,"");
  if(!line) return "";
  if(line.indexOf("://")>=0) return line;
  var p=line.split(":");
  if(p.length>=4){
    var host=p[0], port=p[1], pass=p[p.length-1], user=p.slice(2,p.length-1).join(":");
    return "socks5://"+user+":"+pass+"@"+host+":"+port;
  }
  return line;
}
async function addIpsNow(){
  try{
    var ta=document.getElementById("ip-pool-text");
    var lines=((ta&&ta.value)||"").split(/\n+/).map(normIpLine).filter(Boolean);
    if(!lines.length){ alert("请先填写要新增的 IP"); return; }
    var r=await fetch("/api/ip-pool-add",{
      method:"POST",
      credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({lines:lines})
    });
    var d=await r.json();
    if(ta) ta.value="";
    if(typeof renderIpPoolLocked==="function") await renderIpPoolLocked();
    alert(d.status==="ok" ? ("已保存，当前 "+(d.count||0)+" 条") : ("失败: "+(d.message||r.status)));
  }catch(e){
    alert("保存失败: "+e.message);
  }
}
window.addIpsNow=addIpsNow;
</script>


<script id="ip-pool-lock-js">
(function(){
  if (window.__ipLockBound) return;
  window.__ipLockBound = true;
  function norm(line){
    line = String(line||"").replace(/\s+/g,"");
    if(!line) return "";
    if(line.indexOf("://")>=0) return line;
    var a=line.split(":");
    if(a.length>=4) return "socks5://"+a.slice(2,a.length-1).join(":")+":"+a[a.length-1]+"@"+a[0]+":"+a[1];
    return line;
  }
  async function loadIps(){
    var r=await fetch("/api/ip-pool-add",{credentials:"same-origin"});
    var d=await r.json();
    return d.items||[];
  }
  async function loadAcc(){
    var r=await fetch("/api/accounts",{credentials:"same-origin"});
    var d=await r.json();
    return Array.isArray(d)?d:(d.accounts||[]);
  }
  async function draw(){
    var box=document.getElementById("ip-saved-box");
    if(!box) return;
    var items=await loadIps(), accs=await loadAcc();
    window.__ipItems=items;
    if(!items.length){ box.textContent=" "; return; }
    box.innerHTML="<b>已保存 IP（"+items.length+"）</b>"+items.map(function(it,i){
      var px=it.proxy||it;
      var bound=(it.account_ids||[]).map(String);
      var checks=accs.map(function(a){
        var id=String(a.id);
        return "<label style='display:flex;gap:8px;padding:4px 0;font-size:13px'><input type=checkbox value='"+id+"' "+(bound.indexOf(id)>=0?"checked":"")+">"+(a.name||"")+ " "+(a.phone||id)+"</label>";
      }).join("");
      return "<div style='border:1px solid #e5e7eb;border-radius:8px;padding:12px;margin:10px 0'><div style='word-break:break-all'>"+px+"</div><div class='ip-acc-sel' data-i='"+i+"' style='max-height:200px;overflow:auto;margin:8px 0;padding:8px;background:#fafafa;border:1px solid #eee;border-radius:6px'>"+checks+"</div><button type=button class='btn btn-sm btn-primary' data-bind='"+i+"'>绑定选中的水军号</button></div>";
    }).join("");
    box.querySelectorAll("[data-bind]").forEach(function(b){
      b.onclick=async function(){
        var i=+b.getAttribute("data-bind");
        var it=window.__ipItems[i];
        var wrap=box.querySelector('.ip-acc-sel[data-i="'+i+'"]');
        var ids=[].slice.call(wrap.querySelectorAll("input:checked")).map(function(x){return x.value;});
        var r=await fetch("/api/ip-pool/bind",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({proxy:it.proxy||it,account_ids:ids})});
        var d=await r.json();
        alert(d.status==="ok"?("已绑定 "+ids.length+" 个号"):"绑定失败");
        draw();
      };
    });
  }
  document.addEventListener("click", function(e){
    if(e.target && e.target.id==="btn-save-ip"){
      e.preventDefault();
      var ta=document.getElementById("ip-pool-text");
      var lines=((ta&&ta.value)||"").split(/\n+/).map(norm).filter(Boolean);
      if(!lines.length){ alert("请先填写要新增的 IP"); return; }
      fetch("/api/ip-pool-add",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({lines:lines})})
        .then(function(r){return r.json();})
        .then(function(d){ if(ta) ta.value=""; alert(d.status==="ok"?("已保存，当前 "+d.count+" 条"):("失败 "+(d.message||""))); draw(); })
        .catch(function(e){ alert("保存失败 "+e.message); });
    }
  });
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", draw);
  else draw();
})();
</script>


<script id="tab-iso-js">
(function(){
  function only(name){
    document.querySelectorAll(".tab-content").forEach(function(el){
      el.classList.toggle("active", el.id==="tab-"+name || el.id===name);
    });
    document.querySelectorAll(".tab").forEach(function(el){
      var n=(el.getAttribute("onclick")||"")+(el.textContent||"");
      el.classList.toggle("active", n.indexOf(name)>=0);
    });
  }
  document.addEventListener("click", function(e){
    var el=e.target.closest(".tab");
    if(!el) return;
    var txt=(el.textContent||"").trim();
    if(txt.indexOf("IP")>=0 && txt.indexOf("API")<0){ e.stopPropagation(); only("ip"); }
    if(txt.indexOf("API")>=0){ e.stopPropagation(); only("api"); }
  }, true);
  if(location.hash==="#api") only("api");
})();
</script>




<script id="ip-bind-js">
(function(){
  async function accs(){
    try{
      var r=await fetch("/api/accounts",{credentials:"same-origin"});
      var d=await r.json();
      return Array.isArray(d)?d:(d.accounts||[]);
    }catch(e){return [];}
  }
  async function ips(){
    try{
      var r=await fetch("/api/ip-pool-add",{credentials:"same-origin"});
      var d=await r.json();
      return d.items||[];
    }catch(e){return [];}
  }
  async function drawIpBind(){
    var box=document.getElementById("ip-saved-box");
    if(!box) return;
    var items=await ips(), list=await accs();
    window.__ipItems=items;
    if(!items.length){ box.textContent=" "; return; }
    box.innerHTML="<div style='font-weight:700;margin:8px 0'>已保存 IP（"+items.length+"）</div>"+items.map(function(it,i){
      var px=it.proxy||it;
      var bound=(it.account_ids||[]).map(String);
      var checks=list.map(function(a){
        var id=String(a.id);
        var on=bound.indexOf(id)>=0?"checked":"";
        return "<label style='display:flex;align-items:center;gap:8px;padding:4px 0;font-size:13px'><input type='checkbox' value='"+id+"' "+on+">"+(a.name||"账号")+" "+(a.phone||id)+"</label>";
      }).join("") || "<div style='color:#888;font-size:12px'>暂无账号</div>";
      return "<div style='border:1px solid #e5e7eb;border-radius:8px;padding:12px;margin:10px 0'><div style='word-break:break-all;font-size:13px;margin-bottom:8px'>"+px+"</div><div style='color:#6b7280;font-size:12px;margin-bottom:6px'>勾选多个水军号绑定这条 IP</div><div class='ip-acc-sel' data-i='"+i+"' style='max-height:220px;overflow:auto;border:1px solid #e5e7eb;border-radius:6px;padding:8px;background:#fafafa'>"+checks+"</div><button type='button' class='btn btn-sm btn-primary' style='margin-top:8px' data-bind='"+i+"'>绑定选中的水军号</button></div>";
    }).join("");
    box.querySelectorAll("[data-bind]").forEach(function(btn){
      btn.onclick=async function(){
        var i=+btn.getAttribute("data-bind");
        var it=window.__ipItems[i];
        var wrap=box.querySelector('.ip-acc-sel[data-i="'+i+'"]');
        var ids=[].slice.call(wrap.querySelectorAll("input:checked")).map(function(x){return x.value;});
        var r=await fetch("/api/ip-pool/bind",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({proxy:it.proxy||it,account_ids:ids})});
        var d=await r.json().catch(function(){return {};});
        alert(d.status==="ok"?("已绑定 "+ids.length+" 个水军号"):("绑定失败 "+(d.message||"")));
        drawIpBind();
      };
    });
  }
  if(document.readyState==="loading") document.addEventListener("DOMContentLoaded", drawIpBind);
  else drawIpBind();
  document.addEventListener("click", function(e){
    if(e.target && ((e.target.textContent||"").indexOf("IP池")>=0)) setTimeout(drawIpBind, 50);
  });
})();
</script>




